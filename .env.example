# Copy this file to `.env` and fill in values for local development.
# Never commit `.env` — it is listed in `.gitignore`.

# Canonical public URL for this site (use subdomain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Analytics (optional — wire up when going live)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (optional — reserved for future backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only API keys (optional — do not expose to client)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADSENSE_ID=
